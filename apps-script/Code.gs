/* Santa's Gift Rush backend — deploy as a Web app. */
const CFG={VERSION:'2026.1',CLOSE:'2026-12-19T10:00:00.000Z',ROUND:45000,COUNTDOWN:3000,GRACE:15000,MAX:3,TZ:'Asia/Seoul'};
const HEADERS={
 Settings:['Key','Value'],
 Players:['PlayerId','DisplayName','NormalizedName','Active'],
 Attempts:['SessionId','StartKey','PlayerId','ChallengeDate','AttemptNumber','State','StartAt','EndAt','ExpiresAt','Seed','RulesVersion','CreatedAt'],
 Results:['SessionId','SubmissionKey','PlayerId','ChallengeDate','Score','TapEventsJson','ReceivedAt','CompletedAt','Valid'],
 FinalStandings:['Rank','PlayerId','DisplayName','OverallScore','BestRound','ReachedAt','FinalizedAt']
};
function doGet(e){try{const op=String(e.parameter.op||'status'),p=JSON.parse(e.parameter.payload||'{}');return json_(route_(op,p))}catch(err){return json_({ok:false,error:String(err.message||err),serverNow:new Date().toISOString()})}}
function route_(op,p){if(op==='status')return publicStatus_();if(op==='lookup')return lookup_(p.name);if(op==='start')return start_(p);if(op==='submit')return submit_(p);if(op==='submission')return submission_(p.sessionId);if(op==='final')return final_();throw Error('Unknown operation')}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
function book_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Set SHEET_ID in Script Properties.');return SpreadsheetApp.openById(id)}
function initializeSheets(){const ss=book_();Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);if(s.getLastRow()===0)s.appendRow(HEADERS[n]);else HEADERS[n].forEach((h,i)=>{if(!s.getRange(1,i+1).getValue())s.getRange(1,i+1).setValue(h)})});const s=ss.getSheetByName('Settings');const keys=rows_(s).map(r=>r.Key);[['START_KST','2026-12-01'],['CLOSE_UTC',CFG.CLOSE],['RULES_VERSION',CFG.VERSION]].forEach(r=>{if(!keys.includes(r[0]))s.appendRow(r)});return 'Initialized without deleting existing data.'}
function rows_(sheet){const v=sheet.getDataRange().getValues();if(v.length<2)return[];const h=v[0];return v.slice(1).map((r,n)=>{if(!r.some(x=>x!==''))return null;const o={_row:n+2};h.forEach((x,i)=>{let value=r[i];if(value instanceof Date){const dateOnly=x==='ChallengeDate'||x==='Seed'||(x==='Value'&&r[0]==='START_KST');value=dateOnly?dateKst_(value):value.toISOString()}o[x]=value});return o}).filter(Boolean)}
function literal_(v){v=String(v??'');return /^[=+\-@]/.test(v)?"'"+v:v}
function norm_(v){return String(v||'').trim().toLocaleLowerCase('en-US')}
function now_(){return new Date()}function dateKst_(d){return Utilities.formatDate(d,CFG.TZ,'yyyy-MM-dd')}
function player_(name){const n=norm_(name),ps=rows_(book_().getSheetByName('Players')),dupes=ps.filter(p=>norm_(p.NormalizedName||p.DisplayName)===n);if(dupes.length>1)throw Error('Duplicate normalized roster name; organizer must fix Players.');return dupes.find(p=>String(p.Active).toLowerCase()!=='false')}
function publicStatus_(){const n=now_(),closed=n.getTime()>=Date.parse(CFG.CLOSE);if(closed)finalize_();return{ok:true,serverNow:n.toISOString(),state:closed?'closed':'open',standings:closed?finalRows_():standings_()}}
function lookup_(name){const p=player_(name);if(!p)return{ok:false,error:'That name is not on the family roster. Please contact the organizer.'};const date=dateKst_(now_()),ats=rows_(book_().getSheetByName('Attempts')).filter(a=>a.PlayerId===p.PlayerId&&a.ChallengeDate===date),rs=rows_(book_().getSheetByName('Results')).filter(r=>r.PlayerId===p.PlayerId&&r.ChallengeDate===date&&truth_(r.Valid)),st=standings_(),me=st.find(x=>x.id===p.PlayerId);return{ok:true,serverNow:now_().toISOString(),player:{id:p.PlayerId,name:p.DisplayName},attemptsRemaining:Math.max(0,CFG.MAX-ats.length),todayBest:Math.max(0,...rs.map(r=>+r.Score)),overall:me?me.score:0,standings:st}}
function start_(p){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const n=now_(),startSetting=rows_(book_().getSheetByName('Settings')).find(x=>x.Key==='START_KST'),today=dateKst_(n),latest=Date.parse(CFG.CLOSE)-CFG.COUNTDOWN-CFG.ROUND;if(startSetting&&today<String(startSetting.Value))throw Error('The competition has not started yet.');if(n.getTime()>latest)throw Error('Final rounds are finishing. Winners will be revealed at 7:00 PM KST.');const pl=player_(p.name);if(!pl)throw Error('Unknown player.');const s=book_().getSheetByName('Attempts'),all=rows_(s),old=all.find(a=>a.StartKey===p.key);if(old)return attemptResponse_(old);const active=all.find(a=>a.PlayerId===pl.PlayerId&&a.State==='active'&&Date.parse(a.ExpiresAt)>n.getTime());if(active)throw Error('An official round is already active.');const date=dateKst_(n),used=all.filter(a=>a.PlayerId===pl.PlayerId&&a.ChallengeDate===date).length;if(used>=CFG.MAX)throw Error('No official attempts remain today.');const id=Utilities.getUuid(),start=new Date(n.getTime()+CFG.COUNTDOWN),end=new Date(start.getTime()+CFG.ROUND),exp=new Date(Math.min(Date.parse(CFG.CLOSE),end.getTime()+CFG.GRACE));const row=[id,p.key,pl.PlayerId,date,used+1,'active',start.toISOString(),end.toISOString(),exp.toISOString(),date,CFG.VERSION,n.toISOString()];s.appendRow(row);return attemptResponse_(Object.fromEntries(HEADERS.Attempts.map((h,i)=>[h,row[i]])))}finally{lock.releaseLock()}}
function attemptResponse_(a){return{ok:true,serverNow:now_().toISOString(),sessionId:a.SessionId,date:a.ChallengeDate,attemptNumber:+a.AttemptNumber,seed:a.Seed,startAt:a.StartAt,endAt:a.EndAt,expiresAt:a.ExpiresAt,rulesVersion:a.RulesVersion}}
function submit_(p){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ss=book_(),as=ss.getSheetByName('Attempts'),all=rows_(as),a=all.find(x=>x.SessionId===p.sessionId);if(!a)throw Error('Session not found.');const rs=ss.getSheetByName('Results'),prior=rows_(rs).find(r=>r.SessionId===a.SessionId);if(prior)return{ok:true,confirmed:true,result:{score:+prior.Score},standings:standings_()};const n=now_();if(n.getTime()>Date.parse(CFG.CLOSE)||n.getTime()>Date.parse(a.ExpiresAt))throw Error('Submission deadline passed.');if(a.State!=='active')throw Error('Session is not active.');if(!Array.isArray(p.events)||p.events.length>500)throw Error('Malformed events.');const seq=generate_(a.ChallengeDate,a.RulesVersion),score=score_(seq,p.events),key=p.submissionKey||a.SessionId;rs.appendRow([a.SessionId,key,a.PlayerId,a.ChallengeDate,score,JSON.stringify(p.events),n.toISOString(),n.toISOString(),true]);as.getRange(a._row,6).setValue('completed');return{ok:true,confirmed:true,result:{score},standings:standings_()}}finally{lock.releaseLock()}}
function submission_(id){const r=rows_(book_().getSheetByName('Results')).find(x=>x.SessionId===id);return{ok:true,confirmed:!!r,result:r?{score:+r.Score}:null}}
function truth_(v){return v===true||String(v).toLowerCase()==='true'}
function hash_(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
function random_(seed){let x=seed>>>0;return()=>{x+=0x6D2B79F5;let t=x;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
function generate_(date,version){const r=random_(hash_(date+'|'+version+'|official')),out=[];let t=350,id=0;while(t<44500){const prog=t/45000;t+=850-prog*360+r()*260;const q=r(),type=q<.43?'present':q<.61?'star':q<.78?'snowman':q<.93?'bomb':'photo',spec={present:[10,1,1500],star:[30,1,1200],snowman:[20,3,2200],bomb:[-20,1,1500],photo:[50,1,1500]}[type];out.push({id:'t'+(++id),type,at:Math.round(t),life:spec[2],points:spec[0],hits:spec[1],x:10+r()*80,y:8+r()*84,photo:type==='photo'?Math.floor(r()*3):null})}return out}
function score_(seq,events){const map={};seq.forEach(x=>map[x.id]=x);const st={},ids={};let total=0;events.forEach(e=>{if(ids[e.eventId]||!Number.isFinite(e.t))throw Error('Invalid event.');ids[e.eventId]=1;const t=map[e.targetId];if(!t||e.t<t.at||e.t>t.at+t.life)throw Error('Event outside target lifetime.');const s=st[t.id]||(st[t.id]={hits:0,done:false});if(s.done||++s.hits>t.hits)throw Error('Impossible tap sequence.');if(s.hits===t.hits){s.done=true;total=Math.max(0,total+t.points)}});return total}
function standings_(){const ss=book_(),ps=rows_(ss.getSheetByName('Players')),rs=rows_(ss.getSheetByName('Results')).filter(r=>truth_(r.Valid));return ps.filter(p=>String(p.Active).toLowerCase()!=='false').map(p=>{const pr=rs.filter(r=>r.PlayerId===p.PlayerId),days={};pr.forEach(r=>days[r.ChallengeDate]=Math.max(days[r.ChallengeDate]||0,+r.Score));const vals=Object.values(days).sort((a,b)=>b-a).slice(0,10);return{id:p.PlayerId,name:p.DisplayName,score:vals.reduce((a,b)=>a+b,0),single:Math.max(0,...pr.map(r=>+r.Score)),reached:pr.length?String(pr[pr.length-1].ReceivedAt):'9999'}}).sort((a,b)=>b.score-a.score||b.single-a.single||a.reached.localeCompare(b.reached)||String(a.id).localeCompare(String(b.id))).map((x,i)=>Object.assign(x,{rank:i+1}))}
function finalize_(){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ss=book_(),s=ss.getSheetByName('FinalStandings');if(s.getLastRow()>1)return;const eligible=new Set(rows_(ss.getSheetByName('Results')).filter(r=>truth_(r.Valid)).map(r=>r.PlayerId)),at=now_().toISOString();standings_().filter(x=>eligible.has(x.id)).forEach((x,i)=>s.appendRow([i+1,x.id,literal_(x.name),x.score,x.single,x.reached,at]))}finally{lock.releaseLock()}}
function finalRows_(){return rows_(book_().getSheetByName('FinalStandings')).map(r=>({rank:+r.Rank,id:r.PlayerId,name:r.DisplayName,score:+r.OverallScore,single:+r.BestRound}))}
function final_(){if(now_().getTime()<Date.parse(CFG.CLOSE))throw Error('Final standings are not available yet.');finalize_();return{ok:true,serverNow:now_().toISOString(),standings:finalRows_()}}

